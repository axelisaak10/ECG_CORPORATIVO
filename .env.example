# ECG Corporativo — Variables de entorno
# Copia este archivo como .env (para desarrollo local con el servidor Express en server/)
# En Vercel, configura estas variables en: Settings > Environment Variables

# ── Supabase ──────────────────────────────────────────────────────────────────
# Encontradas en: Supabase Dashboard > Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens de sesión.
# Genera una segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# Correo Gmail desde el que se envían las notificaciones.
# Usa una Contraseña de Aplicación (no tu contraseña normal):
#   Google Account > Seguridad > Verificación en 2 pasos > Contraseñas de aplicación
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL de tu sitio en producción (sin barra final).
# Se usa para los enlaces en emails y para el CORS restrictivo de la API.
FRONTEND_URL=https://tu-dominio.vercel.app

# ── Solo para el servidor Express local (server/) ─────────────────────────────
# No se necesita en Vercel (usa las variables de arriba directamente).
APP_URL=http://localhost:5173
PORT=3001
